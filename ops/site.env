# Réglages publics du site, appliqués au serveur à chaque mise à jour (ops/update.sh).
# Le dépôt est public : AUCUN secret ici (mots de passe, clés API, SMTP_URL restent dans le .env du serveur).
# Une valeur vide garde celle du serveur.
DOMAIN=
MAIL_FROM=
CONTACT_EMAIL=
PRIVACY_EMAIL=
LEGAL_COMPANY=
LEGAL_FORM=
LEGAL_REGISTRATION=
LEGAL_ADDRESS=
LEGAL_DIRECTOR=
LEGAL_HOST=
# open = inscriptions libres ; invite = bêta privée, un code d’invitation est demandé (codes et liste d’attente : back-office, Bêta)
SIGNUP_MODE=
