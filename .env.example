# Copier en .env puis compléter. Sans clé, chaque service passe en mode démonstration.
NODE_ENV=production
# Nom de domaine servi en HTTPS par Caddy (docker-compose.prod.yml), sans https://
DOMAIN=c2pass.cm
PUBLIC_WEB_URL=https://c2pass.cm
API_PUBLIC_URL=https://c2pass.cm
CORS_ORIGINS=https://c2pass.cm
# Nombre de proxys devant l'API (Caddy = 1) : sert à lire la vraie adresse IP pour les limites de requêtes
TRUST_PROXY=1

# Secrets obligatoires en production
# openssl rand -base64 48
JWT_SECRET=
# Clé AES-256 du coffre-fort : openssl rand -base64 32 (à conserver précieusement : la perdre rend les coffres illisibles)
VAULT_KEY=
VAULT_KEY_ID=prod-v1
POSTGRES_PASSWORD=
S3_ACCESS_KEY_ID=c2pass
S3_SECRET_ACCESS_KEY=
# Clé de chiffrement au repos des fichiers audio (stockage S3 de docker compose) : openssl rand -hex 32
S3_SSE_KEY=

# Sauvegardes chiffrées (ops/backup.sh chaque nuit, ops/restore-test.sh chaque mois). Phrase générée par ops/install.sh :
# à copier hors du serveur avec VAULT_KEY et S3_SSE_KEY.
BACKUP_PASSPHRASE=
# Copie hors du serveur (AWS S3, Cloudflare R2, Backblaze B2, OVH Object Storage). Vide = sauvegardes locales seulement.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Correction IA (module 2)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo
LANGUAGETOOL_URL=https://api.languagetool.org
TEXTRAZOR_API_KEY=

# Connexion Google / Facebook (redirection : <API_PUBLIC_URL>/api/auth/oauth/<google|facebook>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Identité légale des mentions légales, CGU et politique de confidentialité (intégrée au site à la construction de l’image)
LEGAL_COMPANY=
LEGAL_FORM=
LEGAL_REGISTRATION=
LEGAL_ADDRESS=
LEGAL_DIRECTOR=
LEGAL_HOST=
CONTACT_EMAIL=contact@c2pass.cm
PRIVACY_EMAIL=dpo@c2pass.cm

# Comptes de démonstration : jamais créés en production, sauf SEED_DEMO_ACCOUNTS=true (serveur de démonstration)
SEED_DEMO_ACCOUNTS=false

# Alertes (module 4) et e-mails (vérification d’adresse, mot de passe oublié) : console = journal uniquement, live = envoi réel
NOTIFICATIONS_MODE=console
SMTP_URL=smtps://user:pass@smtp.exemple.com:465
MAIL_FROM=C2Pass <alertes@c2pass.cm>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Notifications du navigateur (alertes sur téléphone et ordinateur) : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alertes@c2pass.cm

# Paiements : live en production. sandbox = offres activées SANS paiement (un numéro finissant par 0000 simule un échec) ;
# en production, sandbox n'est accepté qu'avec ALLOW_SANDBOX_PAYMENTS=true, à réserver à un serveur de démonstration.
PAYMENTS_MODE=live
ALLOW_SANDBOX_PAYMENTS=false
# Secret du webhook MTN en mode sandbox uniquement : openssl rand -hex 24
PAYMENTS_WEBHOOK_SECRET=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
# CinetPay (agrégateur, paiement de secours et autres opérateurs Mobile Money) : https://app.cinetpay.com
# URL de notification à déclarer : <API_PUBLIC_URL>/api/payments/webhook/cinetpay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Veille légale des centres (5 à 60 minutes)
WATCHER_INTERVAL_MINUTES=7
